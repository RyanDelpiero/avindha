# Salin ke ".env.local" untuk script setup lokal (atau: vercel env pull .env.local).
# Di Vercel, kedua variabel ini diisi lewat Project Settings > Environment Variables.

# Terisi otomatis saat Neon Postgres dihubungkan dari Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# String acak panjang, minimal 32 karakter. Buat dengan:  openssl rand -base64 48
SESSION_SECRET=
